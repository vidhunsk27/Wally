# Copy these into your host's "Environment variables" page (Render) or set them in your terminal for local use.

# A password of your choice. The app asks for it once per device. Without it anyone with your link could read your data.
WALLY_KEY=choose-a-long-random-phrase

# Paste the whole service-account JSON from Firebase here (one line). Leave empty to store data in a local file instead.
FIREBASE_SERVICE_ACCOUNT=

# Port for local use. Hosts such as Render set this themselves.
PORT=3000
